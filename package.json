{
  "name": "leleat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Leleat｜乐乐食谱替餐助手，纯静态幼儿园食谱与过敏替餐展示站点",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "split": "node scripts/split-recipes.mjs",
    "catalog": "node scripts/build-dish-catalog.mjs",
    "sync-variants": "node scripts/sync-variant-ids.mjs",
    "deploy": "npm run build && gh-pages -d dist --dotfiles",
    "measure-docx": "node scripts/measure-docx-height.mjs",
    "check-docx": "node scripts/check-docx.mjs"
  },
  "dependencies": {
    "docx": "^9.5.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "gh-pages": "^6.3.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0"
  }
}
