{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leleat.local/schemas/week-menu.schema.json",
  "title": "Leleat 周表食谱识别中间结果",
  "description": "本地 Agent 从「一周带量食谱及营养分析表」图片抽取后的标准中间格式。该文件不进入前端运行时，仅用于人工复核和生成 recipes.json。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "days", "warnings"],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image",
        "sha256",
        "school",
        "title",
        "printedWeekNumber",
        "dateRange",
        "unit",
        "confidence"
      ],
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "school": {
          "type": ["string", "null"]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "printedWeekNumber": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "dateRange": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": {
              "$ref": "#/$defs/date"
            },
            "end": {
              "$ref": "#/$defs/date"
            }
          }
        },
        "unit": {
          "const": "克"
        },
        "visionModel": {
          "type": "string"
        },
        "promptVersion": {
          "type": "string"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        }
      }
    },
    "days": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "weekday", "isoWeek", "meals"],
        "properties": {
          "date": {
            "$ref": "#/$defs/date"
          },
          "weekday": {
            "enum": ["星期一", "星期二", "星期三", "星期四", "星期五", "星期六", "星期日"]
          },
          "isoWeek": {
            "type": "string",
            "pattern": "^\\d{4}-W(0[1-9]|[1-4][0-9]|5[0-3])$"
          },
          "meals": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "$ref": "#/$defs/meal"
            }
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/warning"
      }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "meal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot", "label", "time", "dishes", "confidence"],
      "properties": {
        "slot": {
          "enum": ["breakfast", "morningSnack", "lunch", "afternoonTea"]
        },
        "label": {
          "enum": ["早餐", "早点", "中餐", "午点"]
        },
        "time": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "dishes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dish"
          }
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        }
      }
    },
    "dish": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "ingredients", "sourceText", "confidence"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "ingredients": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ingredient"
          }
        },
        "sourceText": {
          "type": "string"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "cx": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "cy": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "ingredient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "weightG", "rawWeight"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "weightG": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "rawWeight": {
          "type": ["string", "null"]
        }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "location"],
      "properties": {
        "code": {
          "enum": [
            "LOW_CONFIDENCE",
            "UNREADABLE",
            "DATE_MISMATCH",
            "HEADER_MISMATCH",
            "MEAL_SLOT_MISSING",
            "WEIGHT_MISSING",
            "DUPLICATE_DISH",
            "UNKNOWN_ALLERGEN"
          ]
        },
        "message": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "confidence": {
          "type": ["number", "null"]
        }
      }
    }
  }
}
