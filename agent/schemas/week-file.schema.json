{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leleat.local/schemas/week-file.schema.json",
  "title": "Leleat 单周食谱文件（weeks/YYYY-Www.json）",
  "description": "public/assets/data/weeks/ 下一个 ISO 周一份的食谱正文。前端按 index.json 的 file 字段按需加载；RecipeEntry 是「日期 × 餐次」粒度，dishes 里的 variantId 指回 dish-catalog.json 的同名变体。",
  "type": "object",
  "additionalProperties": false,
  "required": ["week", "startDate", "endDate", "recipes"],
  "properties": {
    "week": {
      "$ref": "#/$defs/week"
    },
    "startDate": {
      "$ref": "#/$defs/date"
    },
    "endDate": {
      "$ref": "#/$defs/date"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "recipes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/recipe"
      }
    }
  },
  "$defs": {
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "week", "mealPeriod", "mealLabel", "dishes"],
      "properties": {
        "date": {
          "$ref": "#/$defs/date"
        },
        "week": {
          "$ref": "#/$defs/week"
        },
        "mealPeriod": {
          "enum": ["breakfast", "morningSnack", "lunch", "afternoonTea", "dinner"]
        },
        "mealLabel": {
          "enum": ["早餐", "早点", "午餐", "午点", "晚餐"]
        },
        "dishes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dish"
          }
        },
        "sourceImage": {
          "description": "该日菜单原图，形如 assets/images/YYYYMMDD-menu.jpg；发布后不改名。",
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string"
        },
        "calorie": {
          "type": ["number", "string"]
        },
        "noteForKindergarten": {
          "type": "string"
        },
        "verified": {
          "type": "boolean"
        }
      }
    },
    "dish": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "ingredients", "riskAllergens", "substitute"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "ingredients": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "riskAllergens": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "substitute": {
          "type": ["string", "null"]
        },
        "variantId": {
          "$ref": "#/$defs/variantId"
        },
        "calorie": {
          "type": ["number", "string"]
        },
        "noteForKindergarten": {
          "type": "string"
        },
        "verified": {
          "type": "boolean"
        }
      }
    },
    "variantId": {
      "description": "菜名#sha1(菜名|食材按 zh-CN 排序后 / 分隔) 前 8 位，内容寻址。",
      "type": "string",
      "pattern": "^.+#[0-9a-f]{8}$"
    },
    "week": {
      "type": "string",
      "pattern": "^\\d{4}-W(0[1-9]|[1-4][0-9]|5[0-3])$"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  }
}
