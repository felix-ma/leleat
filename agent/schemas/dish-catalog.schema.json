{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leleat.local/schemas/dish-catalog.schema.json",
  "title": "Leleat 菜品知识库",
  "description": "按菜名归一化后的菜品知识库，由 scripts/build-dish-catalog.mjs 从 weeks/*.json 全量重建。同名菜的不同配方各占一个 variantId，菜记录保留全部 variants；顶层 ingredients/riskAllergens 只代表主变体（出现次数最多的那版），不是各变体的并集。前端只读，不写入。",
  "type": "object",
  "additionalProperties": false,
  "required": ["dishes"],
  "properties": {
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "dishes": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/dish"
      }
    }
  },
  "$defs": {
    "dish": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "aliases",
        "ingredients",
        "riskAllergens",
        "substitute",
        "firstSeen",
        "lastSeen",
        "occurrences",
        "sourceImages",
        "variants"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "ingredients": {
          "description": "主变体（variants[0]，出现次数最多那版）的食材，不是全部变体的并集。",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "riskAllergens": {
          "description": "主变体（variants[0]）的过敏原，不是全部变体的并集。",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "substitute": {
          "type": ["string", "null"]
        },
        "firstSeen": {
          "$ref": "#/$defs/date"
        },
        "lastSeen": {
          "$ref": "#/$defs/date"
        },
        "occurrences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/occurrence"
          }
        },
        "sourceImages": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "variants": {
          "description": "该菜名下的全部配方变体，按 count 降序；variants[0] 即主变体。",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/variant"
          }
        },
        "needsReview": {
          "description": "同名菜存在多种配方（variants 多于一条）时为 true，进人工复核清单。",
          "type": "boolean"
        },
        "verified": {
          "type": "boolean"
        }
      }
    },
    "occurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "mealPeriod", "variantId"],
      "properties": {
        "date": {
          "$ref": "#/$defs/date"
        },
        "mealPeriod": {
          "enum": ["breakfast", "morningSnack", "lunch", "afternoonTea", "dinner"]
        },
        "variantId": {
          "$ref": "#/$defs/variantId"
        }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variantId",
        "ingredients",
        "riskAllergens",
        "count",
        "firstSeen",
        "lastSeen"
      ],
      "properties": {
        "variantId": {
          "$ref": "#/$defs/variantId"
        },
        "ingredients": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "riskAllergens": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "firstSeen": {
          "$ref": "#/$defs/date"
        },
        "lastSeen": {
          "$ref": "#/$defs/date"
        }
      }
    },
    "variantId": {
      "description": "菜名#sha1(菜名|食材按 zh-CN 排序后 / 分隔) 前 8 位，内容寻址。",
      "type": "string",
      "pattern": "^.+#[0-9a-f]{8}$"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  }
}
